# Copy to .env.production on the deployment host. Do not commit the populated file.
# Use the managed PostgreSQL provider's private TLS connection string.
DATABASE_URL=postgresql://APP_USER:REPLACE_ME@DB_HOST:5432/APP_DATABASE?sslmode=require

# Store real credentials here only on the host or inject them from its secret manager.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
BDNS_REVIEW_TOKEN=

# Local bind for a TLS reverse proxy on the same host.
FRONTEND_PORT=3000
