# Copy this file to .env and fill it in. NEVER commit .env.

# --- Branding ---
APP_NAME=El Vecino que Sabe

# --- LLM (any OpenAI-compatible API; Groq by default: https://console.groq.com) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
MAX_AGENT_ITERATIONS=4
# single = code runs the tools and the LLM writes once (fits Groq's free 8000 tokens/minute)
# loop   = the LLM chooses the tools itself (3-4 calls per answer; needs Groq's Developer plan)
AGENT_MODE=single

# --- Postgres (docker compose uses it to create the database and to build DATABASE_URL) ---
POSTGRES_PASSWORD=elvecino_dev
# Host ports; change these when another local project already uses the defaults.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
SEED_ON_START=true

# --- CORS (only if the frontend is served from another domain) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- BDNS / SNPSAP ingestion client (read-only; TLS verification stays enabled) ---
BDNS_API_BASE_URL=https://www.infosubvenciones.es/bdnstrans/api
BDNS_PORTAL_ID=GE
BDNS_TIMEOUT_SECONDS=30
BDNS_MIN_REQUEST_INTERVAL_SECONDS=1
BDNS_CACHE_TTL_SECONDS=300
BDNS_MAX_RETRIES=2
BDNS_MAX_PAGE_SIZE=100
BDNS_DOCUMENT_MAX_BYTES=26214400
BDNS_DOCUMENT_STORAGE_DIR=/app/storage/bdns
BDNS_LINK_CHECK_INTERVAL_SECONDS=1
# Set a long random secret to enable the internal review page/API. Blank disables it.
BDNS_REVIEW_TOKEN=
